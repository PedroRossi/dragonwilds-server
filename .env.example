# Values for the Portainer stack "Environment variables" section (do not commit a real .env).
RSDW_OWNER_ID=            # your Player ID: in game, Settings menu, bottom of the page
RSDW_SERVER_NAME=         # "Created by" column
RSDW_WORLD_NAME=          # world/save name players search for; case-sensitive, short, no spaces
RSDW_PASSWORD=            # join password; leave EMPTY (but defined) for an open world
RSDW_ADMIN_PASSWORD=      # Server Management screen password
RSDW_ADMINS=              # optional: comma-separated Player IDs with admin rights
RSDW_ADDITIONAL_ARGS=     # optional extra launch args
STEAMAPPVALIDATE=0        # set 1 once to re-validate files
